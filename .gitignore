# Internal-only: kept on disk, not published
docs/
*-paper/
*-review/
*_review/
*-rebuttal/
*_rebuttal/

# Evaluator outputs are regenerated by the pipeline; only the scripts are tracked.
# (`dir/*` rather than `dir/`, so the re-includes below can reach inside.)
sandwich-intent/data/*
# ...except the price snapshot, which pins every USD figure in the paper,
!sandwich-intent/data/token_prices/
sandwich-intent/data/token_prices/*
!sandwich-intent/data/token_prices/prices.csv
# ...and the Jito bundle verdicts: Jito reclaims bundle CONTENT after a few epochs,
# so these cannot be re-fetched for the measurement window by anyone, including us.
!sandwich-intent/data/jito_bundle_ids/
sandwich-intent/data/jito_bundle_ids/*
!sandwich-intent/data/jito_bundle_ids/*.csv
# ...and the expert panel's adjudicated verdicts, which phase 3 annotates attackers with.
!sandwich-intent/data/expert_audit/
sandwich-intent/data/expert_audit/*
!sandwich-intent/data/expert_audit/results/
sandwich-intent/data/expert_audit/results/*
!sandwich-intent/data/expert_audit/results/cases_summary.csv

# Public dataset: track parquet + csv outputs
!/dataset/**/*.parquet
!/dataset/**/*.csv

# Analysis outputs are regenerated from the intent dataset by the scripts that draw them.
sandwich-analysis/figures/
sandwich-analysis/results/

# planning-with-files working memory (not for commit)
task_plan.md
findings.md
progress.md
.planning/

# Python bytecode
__pycache__/
*.pyc
