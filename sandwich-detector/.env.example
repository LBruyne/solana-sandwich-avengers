CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=solwich_v2
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=sol

# RPC API keys — composed with the base URLs in config.yaml at runtime, so no keyed URL is ever
# written to config or logs.
# CHAINSTACK_API_KEY joins sol.rpc-chainstack as its URL path (the default RPC, live + backfill).
CHAINSTACK_API_KEY=YOUR-API-KEY
# HELIUS_RPC_API_KEY joins sol.rpc-helius as ?api-key= (archival fallback for backfill).
HELIUS_RPC_API_KEY=YOUR-API-KEY
