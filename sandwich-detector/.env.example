CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=solwich_v2
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=sol

# Primary RPC lives in config.yaml (sol.rpc — Chainstack Core, archival + paid).
# HELIUS_RPC_API_KEY is only a backfill fallback used when neither sol.rpc nor sol.rpc-archival
# is archival. Leave as-is to disable the fallback.
HELIUS_RPC_API_KEY=YOUR-API-KEY
